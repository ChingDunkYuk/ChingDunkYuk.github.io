---
import { getDict, type Locale } from '../i18n/config';
import { now } from '../data/now';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);
---

<!-- ============ 01 · now (what's on the bench) ============ -->
<section class="section" id="now">
  <div class="container">
    <header class="section-head">
      <span class="index" aria-hidden="true">01</span>
      <h2>{t.sections.now}</h2>
    </header>

    <!-- set like a terminal readout: prompt, entries, timestamp -->
    <div class="now">
      <p class="now-prompt mono" aria-hidden="true">{t.now.prompt}</p>
      <ul class="now-list mono" role="list">
        {
          now.items.map((item) => (
            <li role="listitem">
              <span class="now-k">
                <span class="now-mark" aria-hidden="true">&blacktriangleright;</span>
                {item.name[locale]}
              </span>
              <span class="now-v">{item.description[locale]}</span>
            </li>
          ))
        }
      </ul>
      <p class="now-updated mono">{t.now.updatedPrefix} · {now.updated}</p>
    </div>
  </div>
</section>

<style>
  /* ---------- now (live status, set like a terminal readout) ---------- */
  .now {
    max-width: 44rem;
  }

  .now-prompt {
    color: var(--accent);
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
  }

  .now-list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
  }

  .now-list li {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.15rem;
    padding-block: var(--space-3);
  }

  .now-list li + li {
    border-top: var(--border);
    padding-block: var(--space-4);
  }

  @media (min-width: 40rem) {
    .now-list li {
      grid-template-columns: 11rem 1fr;
      gap: var(--space-4);
      align-items: baseline;
    }
  }

  .now-k {
    color: var(--ink);
    letter-spacing: 0.01em;
  }

  .now-mark {
    color: var(--accent);
    margin-right: 0.5em;
  }

  .now-v {
    color: var(--ink-soft);
    line-height: 1.65;
  }

  .now-updated {
    margin-top: var(--space-4);
    color: var(--ink-faint);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
  }
</style>
