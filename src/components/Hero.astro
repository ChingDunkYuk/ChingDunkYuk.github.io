---
import { getDict, type Locale } from '../i18n/config';
import { site } from '../config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);

// CJK glyphs do not italicize — the serif quote stays upright in
// Chinese instead of getting a faux-oblique slant.
const upright = locale !== 'en';
---

<!-- ============ hero ============ -->
<section class="hero" aria-label={t.hero.region}>
  {/* the personal mark, blown up into a ghost watermark on the
      darkroom wall — desktop/tablet only; phones keep it clean */}
  <img
    class="watermark"
    src={site.logo.default}
    alt=""
    width="725"
    height="834"
    decoding="async"
    aria-hidden="true"
  />

  <div class="container">
    <p class="prompt mono">{t.hero.prompt}</p>
    <h1>{site.name}</h1>
    <p class="role mono">{t.hero.role}</p>

    <p class:list={['quote', { upright }]}>{t.hero.quote}</p>
    <p class="quote-note mono">
      {t.hero.note}<span class="cursor" aria-hidden="true"></span>
    </p>
  </div>
</section>

<style>
  /* ---------- hero (~65vh — Now peeks in at the fold) ---------- */
  .hero {
    position: relative; /* anchor for the ghost mark */
    overflow: hidden; /* clips its right bleed, no page scrollbar */
    min-height: calc(65vh - var(--header-h));
    min-height: calc(65svh - var(--header-h));
    display: flex;
    align-items: center;
    /* bias the block upward — extra bottom padding lifts the
       optical centre, so the hero sits slightly high instead of
       dead-centre, and the fold belongs to Now */
    padding-block: var(--space-7) calc(var(--space-6) + 10vh);
  }

  /* the type always sits above the ghost mark */
  .hero .container {
    position: relative;
    z-index: 1;
  }

  .prompt {
    color: var(--accent);
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
  }

  .hero h1 {
    font-size: var(--text-hero);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin-bottom: var(--space-4);
  }

  /* wide screens: the name carries the frame — ~12% larger.
     Phones keep the token size. */
  @media (min-width: 40rem) {
    .hero h1 {
      font-size: calc(var(--text-hero) * 1.12);
    }
  }

  .role {
    color: var(--ink-soft);
    font-size: var(--text-md);
    margin-bottom: var(--space-7);
  }

  .quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.25rem, 1rem + 1vw, 1.625rem);
    line-height: 1.5;
    max-width: 38ch;
    margin-bottom: var(--space-4);
  }

  .quote.upright {
    font-style: normal;
  }

  .quote-note {
    color: var(--ink-faint);
    font-size: var(--text-sm);
  }

  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.15em;
    vertical-align: text-bottom;
    background: var(--ink-faint);
    animation: blink 1.2s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* ---------- the ghost mark ----------
     The logo blown up on the darkroom wall — faint enough to
     never fight the type, bleeding off the right edge like a
     frame crop. Phones keep the hero clean. */
  .watermark {
    position: absolute;
    top: 50%;
    right: clamp(-9rem, -8vw, -2rem);
    transform: translateY(-50%);
    height: min(38rem, 52vh);
    width: auto;
    opacity: 0.035;
    pointer-events: none;
    user-select: none;
  }

  /* paper stock — cream would vanish on cream, so the mark is
     re-inked warm-black (same trick as the header logo) */
  html[data-theme='light'] .watermark {
    filter: brightness(0.16) saturate(0.8);
    opacity: 0.04;
  }

  @media (max-width: 40rem) {
    .watermark {
      display: none;
    }
  }

  /* ---------- small screens ---------- */
  @media (max-width: 30rem) {
    /* keep the role line on one line */
    .role {
      font-size: var(--text-base);
    }
  }
</style>
