---
import { getDict, type Locale } from '../i18n/config';
import { site } from '../config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);

// CJK glyphs do not italicize — the serif quote stays upright in
// Chinese instead of getting a faux-oblique slant.
const upright = locale !== 'en';
---

<!-- ============ hero ============ -->
<section class="hero" aria-label={t.hero.region}>
  <div class="container">
    <p class="prompt mono">{t.hero.prompt}</p>
    <h1>{site.name}</h1>
    <p class="role mono">{t.hero.role}</p>

    <p class:list={['quote', { upright }]}>{t.hero.quote}</p>
    <p class="quote-note mono">
      {t.hero.note}<span class="cursor" aria-hidden="true"></span>
    </p>
  </div>
</section>

<style>
  /* ---------- hero (~62vh — the editorial spread) ----------
     Not a landing-page banner. The block shares the left axis
     with every section below (the .container rules them all),
     hangs a touch above the middle, and simply leaves the right
     half empty — negative space is the layout, not a gap to
     fill. */
  .hero {
    min-height: calc(62vh - var(--header-h));
    min-height: calc(62svh - var(--header-h));
    /* column, not row: in a row flex the .container would shrink to
       fit-content and its margin-inline auto would centre the block
       mid-viewport — a landing-page look. Column + stretch keeps the
       container block-level (max-width, auto margins), so the type
       sits on the same left axis as every section below. */
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* slight upward bias — the fold below belongs to Now */
    padding-block: var(--space-7) calc(var(--space-6) + 6vh);
  }

  /* keep the hero block on the section grid below:
     a flex item's auto width collapses to fit-content, and its
     auto margins then centre that shrunken block mid-viewport
     (the landing-page look). An explicit width restores the
     block-level footprint: stretch to the section, clamp at
     64rem, auto margins centre the column — same left edge as
     every section below. */
  .hero .container {
    width: 100%;
  }

  .prompt {
    color: var(--accent);
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
  }

  .hero h1 {
    font-size: var(--text-hero);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin-bottom: var(--space-4);
  }

  /* wide screens: the name carries the frame — ~12% larger.
     Phones keep the token size. */
  @media (min-width: 40rem) {
    .hero h1 {
      font-size: calc(var(--text-hero) * 1.12);
    }
  }

  .role {
    color: var(--ink-soft);
    font-size: var(--text-md);
    margin-bottom: var(--space-7);
  }

  .quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.25rem, 1rem + 1vw, 1.625rem);
    line-height: 1.5;
    max-width: 38ch;
    margin-bottom: var(--space-4);
  }

  .quote.upright {
    font-style: normal;
  }

  .quote-note {
    color: var(--ink-faint);
    font-size: var(--text-sm);
  }

  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.15em;
    vertical-align: text-bottom;
    background: var(--ink-faint);
    animation: blink 1.2s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* ---------- small screens ---------- */
  @media (max-width: 30rem) {
    /* keep the role line on one line */
    .role {
      font-size: var(--text-base);
    }
  }
</style>
