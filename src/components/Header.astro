---
import { getDict, localeBase, type Locale } from '../i18n/config';
import { site } from '../config/site';
import { navItems } from '../data/navigation';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark mono" href={localeBase[locale]}>
      <span class="logo-wrap">
        <img
          class="logo logo-cream"
          src={site.logo.default}
          alt=""
          width="725"
          height="834"
          decoding="async"
        />
        <img
          class="logo logo-amber"
          src={site.logo.hover}
          alt=""
          width="111"
          height="128"
          decoding="async"
        />
      </span>
      ~/tungyuk<span class="word-cursor" aria-hidden="true"></span>
    </a>

    <div class="header-right">
      <nav class="site-nav mono" aria-label={t.header.navLabel}>
        {
          navItems.map((item) => (
            <a class="nav-link" href={`#${item.id}`} data-icon={item.id} aria-label={item.label[locale]}>
              <svg class="nav-icon" viewBox="0 -960 960 960" aria-hidden="true" focusable="false">
                <path d={item.icon} />
              </svg>
              <span class="nav-tip" aria-hidden="true">{item.label[locale]}</span>
            </a>
          ))
        }
      </nav>

      {/* theme switch — icon of the theme you'd get (sun while dark,
          moon while light); labels/tooltip come from the dicts and
          are synced to the live state by CSS + the toggle script */}
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-label={t.header.themeToLight}
        data-label-light={t.header.themeToLight}
        data-label-dark={t.header.themeToDark}
      >
        <svg class="nav-icon tt-sun" viewBox="0 -960 960 960" aria-hidden="true" focusable="false">
          <path
            d="M480-360q50 0 85-35t35-85q0-50-35-85t-85-35q-50 0-85 35t-35 85q0 50 35 85t85 35Zm0 80q-83 0-141.5-58.5T280-480q0-83 58.5-141.5T480-680q83 0 141.5 58.5T680-480q0 83-58.5 141.5T480-280ZM200-440H40v-80h160v80Zm720 0H760v-80h160v80ZM440-760v-160h80v160h-80Zm0 720v-160h80v160h-80ZM256-650l-101-97 57-59 96 100-52 56Zm492 496-97-101 53-55 101 97-57 59Zm-98-550 97-101 59 57-100 96-56-52ZM154-212l101-97 55 53-97 101-59-57Zm326-268Z"
          />
        </svg>
        <svg class="nav-icon tt-moon" viewBox="0 -960 960 960" aria-hidden="true" focusable="false">
          <path
            d="M480-120q-150 0-255-105T120-480q0-150 105-255t255-105q14 0 27.5 1t26.5 3q-41 29-65.5 75.5T444-660q0 90 63 153t153 63q55 0 101-24.5t75-65.5q2 13 3 26.5t1 27.5q0 150-105 255T480-120Zm0-80q88 0 158-48.5T740-375q-20 5-40 8t-40 3q-123 0-209.5-86.5T364-660q0-20 3-40t8-40q-78 32-126.5 102T200-480q0 116 82 198t198 82Zm-10-270Z"
          />
        </svg>
        <span class="nav-tip tt-to-light" aria-hidden="true">{t.header.themeToLight}</span>
        <span class="nav-tip tt-to-dark" aria-hidden="true">{t.header.themeToDark}</span>
      </button>

      <nav class="lang-switch mono" aria-label={t.header.langLabel}>
        <a href={localeBase.en} data-lang-switch aria-current={locale === 'en' ? 'true' : undefined}>
          {t.header.langEn}
        </a>
        <span class="sep" aria-hidden="true">/</span>
        <a href={localeBase['zh-hk']} data-lang-switch aria-current={locale === 'zh-hk' ? 'true' : undefined}>
          {t.header.langZh}
        </a>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    flex-wrap: wrap;
    min-height: var(--header-h);
    padding-block: var(--space-2);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  /* the logo mark is cream-on-transparent, tuned for the dark bg;
     an amber twin sits on top for the hover crossfade */
  .logo-wrap {
    position: relative;
    display: block;
    flex: none;
    height: 32px;
    aspect-ratio: 725 / 834;
    transition: transform 0.9s var(--ease);
  }

  .logo-wrap .logo {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    object-fit: contain;
  }

  .logo-cream,
  .logo-amber {
    transition: opacity 0.4s var(--ease);
  }

  .logo-amber {
    opacity: 0;
  }

  /* phosphor tube ignition — one quick flicker on page load, then steady */
  .logo-cream {
    animation: logo-boot 0.8s 0.1s linear backwards;
  }

  @keyframes logo-boot {
    0% { opacity: 0; }
    10% { opacity: 0; }
    14% { opacity: 0.85; }
    18% { opacity: 0.1; }
    26% { opacity: 1; }
    32% { opacity: 0.3; }
    42% { opacity: 1; }
    50% { opacity: 0.75; }
    62% { opacity: 1; }
    100% { opacity: 1; }
  }

  /* paper stock — the cream mark would vanish on cream paper, so
     both twins are re-inked with filters instead of new assets:
     cream→warm-black (meets --ink), amber→baked-down amber (meets
     --accent). The boot flicker only animates opacity, so the
     re-ink never fights it. */
  html[data-theme='light'] .logo-cream {
    filter: brightness(0.16);
  }

  html[data-theme='light'] .logo-amber {
    filter: brightness(0.7) saturate(0.8);
  }

  /* hover / keyboard focus: slow dial turn, cream mark crossfades to amber */
  .wordmark:hover .logo-wrap,
  .wordmark:focus-visible .logo-wrap {
    transform: rotate(90deg);
  }

  .wordmark:hover .logo-cream,
  .wordmark:focus-visible .logo-cream {
    opacity: 0;
  }

  .wordmark:hover .logo-amber,
  .wordmark:focus-visible .logo-amber {
    opacity: 1;
  }

  .wordmark:hover {
    color: var(--accent);
  }

  /* terminal block cursor — echoes the hero blink, joins the amber
     crossfade on hover */
  .word-cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.15em;
    vertical-align: text-bottom;
    background: var(--ink-faint);
    animation: wordmark-blink 1.2s steps(1) infinite;
    transition: background 0.4s var(--ease);
  }

  @keyframes wordmark-blink {
    50% {
      opacity: 0;
    }
  }

  .wordmark:hover .word-cursor,
  .wordmark:focus-visible .word-cursor {
    background: var(--accent);
  }

  .header-right {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }

  .site-nav {
    --icon-size: 22px;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
  }

  /* icon-only nav — the section name lives in aria-label + tooltip */
  .site-nav a {
    position: relative; /* tooltip anchor */
    display: inline-flex;
    align-items: center;
    /* tap area around the icon (~36px target) */
    padding: var(--space-2);
    color: var(--ink-soft);
    text-decoration: none;
    border-radius: var(--radius);
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: var(--accent);
  }

  .nav-icon {
    width: var(--icon-size);
    height: var(--icon-size);
    fill: currentColor; /* follows ink-soft → accent */
  }

  /* -- hover micro-animations ---------------------------------------
     One shot per icon as the cursor arrives, each themed to its
     object; replays on the next visit. Keyboard focus gets the
     same beat via :focus-visible, matching the tooltip. Pure CSS.

     Written longhand on purpose: a var() inside the animation
     shorthand hides the keyframes name from tooling (the CSSOM
     reads animationName back empty), so every value gets its own
     line where the name stands alone. */
  .site-nav a[data-icon='now']:hover .nav-icon,
  .site-nav a[data-icon='now']:focus-visible .nav-icon {
    /* the hourglass flips with an overshoot and settles upright —
       the icon is vertically symmetric, so the end state reads as
       the start and the snap back on mouse-out is invisible */
    animation-name: nav-hourglass;
    animation-duration: 0.75s;
    animation-timing-function: var(--ease);
  }

  @keyframes nav-hourglass {
    0% { transform: rotate(0deg) scale(1); }
    55% { transform: rotate(198deg) scale(1.12); }
    78% { transform: rotate(174deg) scale(1.05); }
    100% { transform: rotate(180deg) scale(1); }
  }

  .site-nav a[data-icon='projects']:hover .nav-icon,
  .site-nav a[data-icon='projects']:focus-visible .nav-icon {
    /* the CRT retrace — dies hard, snaps back, dies again, holds */
    animation-name: nav-flicker;
    animation-duration: 0.6s;
    animation-timing-function: linear;
  }

  @keyframes nav-flicker {
    0% { opacity: 1; transform: translateY(0); }
    12% { opacity: 0; transform: translateY(-1px); }
    24% { opacity: 1; transform: translateY(0); }
    40% { opacity: 0.15; transform: translateY(1px); }
    54% { opacity: 1; transform: translateY(0); }
    70% { opacity: 0.45; }
    100% { opacity: 1; }
  }

  .site-nav a[data-icon='photography']:hover .nav-icon,
  .site-nav a[data-icon='photography']:focus-visible .nav-icon {
    /* the film advance — one hard jerk with a sprocket wobble */
    animation-name: nav-advance;
    animation-duration: 0.6s;
    animation-timing-function: ease-out;
  }

  @keyframes nav-advance {
    0% { transform: translateX(0) rotate(0deg); }
    40% { transform: translateX(-34%) rotate(-6deg); }
    68% { transform: translateX(-26%) rotate(3deg); }
    100% { transform: translateX(0) rotate(0deg); }
  }

  .site-nav a[data-icon='writing']:hover .nav-icon,
  .site-nav a[data-icon='writing']:focus-visible .nav-icon {
    /* the page turn — the open book flips over in 2D, fattening
       as it comes face-on */
    animation-name: nav-pageflip;
    animation-duration: 0.7s;
    animation-timing-function: var(--ease);
  }

  @keyframes nav-pageflip {
    50% {
      transform: scaleX(-1) scale(1.16);
    }
  }

  .site-nav a[data-icon='about']:hover .nav-icon,
  .site-nav a[data-icon='about']:focus-visible .nav-icon {
    /* the autofocus lock — hunt past, pull through, lock */
    animation-name: nav-focus;
    animation-duration: 0.55s;
    animation-timing-function: var(--ease);
  }

  @keyframes nav-focus {
    0% { transform: scale(1); }
    32% { transform: scale(1.45); }
    54% { transform: scale(0.9); }
    76% { transform: scale(1.08); }
    100% { transform: scale(1); }
  }

  /* tooltip — plain visibility toggle, no animation */
  .nav-tip {
    position: absolute;
    top: calc(100% + var(--space-1));
    left: 50%;
    transform: translateX(-50%);
    padding: var(--space-1) var(--space-2);
    background: var(--surface-dim);
    color: var(--ink-soft);
    border: var(--border);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
    visibility: hidden;
    pointer-events: none;
    z-index: 10;
  }

  /* hover tooltip — real pointers only (touch taps never show it) */
  @media (hover: hover) {
    .site-nav a:hover .nav-tip {
      visibility: visible;
    }
  }

  /* keyboard focus — tooltip on every device */
  .site-nav a:focus-visible .nav-tip {
    visibility: visible;
  }

  /* -- theme switch --------------------------------------------------
     Mirrors the nav-icon pattern: same size, tap area, ink→amber
     hover and tooltip. It sits between the section nav and the
     language switch. The icon always shows the theme you would
     GET (sun while dark, moon while light); which one renders is
     pure CSS driven by html[data-theme], so it swaps with zero
     flash and no DOM work. */
  .theme-toggle {
    --icon-size: 22px;
    position: relative; /* tooltip anchor */
    display: inline-flex;
    align-items: center;
    padding: var(--space-2);
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--ink-soft);
    border-radius: var(--radius);
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    color: var(--accent);
  }

  html:not([data-theme='light']) .tt-moon,
  html:not([data-theme='light']) .tt-to-dark {
    display: none;
  }

  html[data-theme='light'] .tt-sun,
  html[data-theme='light'] .tt-to-light {
    display: none;
  }

  @media (hover: hover) {
    .theme-toggle:hover .nav-tip {
      visibility: visible;
    }
  }

  .theme-toggle:focus-visible .nav-tip {
    visibility: visible;
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    border-left: var(--border);
    padding-left: var(--space-4);
  }

  .lang-switch a {
    color: var(--ink-faint);
    text-decoration: none;
    padding-block: 6px;
  }

  .lang-switch a:hover {
    color: var(--accent);
  }

  .lang-switch a[aria-current='true'] {
    color: var(--ink);
  }

  .lang-switch .sep {
    color: var(--ink-faint);
  }
</style>
