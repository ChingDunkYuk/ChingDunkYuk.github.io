---
import { getDict, type Locale } from '../i18n/config';
import { site } from '../config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner mono">
    <span>&copy; {year} {site.name}</span>
    <span class="footer-links">
      <a href={site.github} rel="me noopener noreferrer" target="_blank">github</a>
      <span class="dim" aria-hidden="true">&middot;</span>
      <span class="dim">{t.footer.builtWith}</span>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border);
    padding-block: var(--space-5);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .footer-links {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .footer-links a {
    color: var(--ink-faint);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  .dim {
    color: var(--ink-faint);
  }
</style>
