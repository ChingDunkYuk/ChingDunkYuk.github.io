---
import { getDict, type Locale } from '../i18n/config';
import { projectLinks } from '../data/projects';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);

// CJK glyphs do not italicize — the serif quote and the email
// placeholder stay upright in Chinese instead of getting a
// faux-oblique slant.
const upright = locale !== 'en';

// Frame layout slots (aspect ratios live in the styles below).
const frameSlots = ['ph-a', 'ph-b', 'ph-c', 'ph-d'];
---

<!-- ============ hero ============ -->
<section class="hero" aria-label={t.hero.region}>
  <div class="container">
    <p class="prompt mono">{t.hero.prompt}</p>
    <h1>Tung Yuk</h1>
    <p class="role mono">{t.hero.role}</p>

    <p class:list={['quote', { upright }]}>{t.hero.quote}</p>
    <p class="quote-note mono">
      {t.hero.note}<span class="cursor" aria-hidden="true"></span>
    </p>

    <a class="scroll-hint mono" href="#projects">
      <span aria-hidden="true">&darr;</span> {t.hero.scroll}
    </a>
  </div>
</section>

<!-- ============ 01 · selected projects ============ -->
<section class="section" id="projects">
  <div class="container">
    <header class="section-head">
      <span class="index" aria-hidden="true">01</span>
      <h2>{t.sections.projects}</h2>
    </header>

    <ul class="project-grid" role="list">
      {
        t.projects.map((project) => {
          const href = projectLinks[project.name] ?? '#';
          // '#' means "not published yet" — no external affordances.
          const external = href !== '#';
          return (
            <li class="project">
              <h3>
                <a
                  href={href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener' : undefined}
                >
                  {project.name}
                  {external && (
                    <span class="ext mono" aria-hidden="true">
                      &nearr;
                    </span>
                  )}
                </a>
              </h3>
              <p class="desc">{project.description}</p>
              <p class="meta mono">{project.meta}</p>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<!-- ============ 02 · photography ============ -->
<section class="section" id="photography">
  <div class="container">
    <header class="section-head">
      <span class="index" aria-hidden="true">02</span>
      <h2>{t.sections.photography}</h2>
    </header>

    <!-- Irregular frame sizes: real photos will replace the
         placeholders, each keeping its own aspect ratio. -->
    <div class="photo-grid" role="list" aria-label={t.photography.listLabel}>
      {
        t.photography.frames.map((label, i) => (
          <figure class:list={['ph', frameSlots[i]]} role="listitem">
            <div class="ph-frame" />
            <figcaption class="mono">
              {String(i + 1).padStart(2, '0')} &middot; {label}
            </figcaption>
          </figure>
        ))
      }
    </div>

    <p class="section-note">{t.photography.note}</p>
  </div>
</section>

<!-- ============ 03 · writing ============ -->
<section class="section" id="writing">
  <div class="container">
    <header class="section-head">
      <span class="index" aria-hidden="true">03</span>
      <h2>{t.sections.writing}</h2>
    </header>

    <ul class="post-list" role="list">
      {
        t.writing.posts.map((post) => (
          <li class="post" role="listitem">
            <time class="mono">{post.time}</time>
            <div class="post-body">
              <h3>{post.title}</h3>
              <p>{post.excerpt}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- ============ 04 · about ============ -->
<section class="section" id="about">
  <div class="container">
    <header class="section-head">
      <span class="index" aria-hidden="true">04</span>
      <h2>{t.sections.about}</h2>
    </header>

    <div class="about">
      <div class="about-text">
        {t.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <ul class="contact mono" role="list">
        <li>
          <span class="k">{t.about.githubLabel}</span>
          <a href="https://github.com/ChingDunkYuk" rel="me noopener" target="_blank">
            github.com/ChingDunkYuk <span aria-hidden="true">&nearr;</span>
          </a>
        </li>
        <li>
          <span class="k">{t.about.emailLabel}</span>
          <span class:list={['pending', { upright }]}>{t.about.emailPending}</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  /* ---------- hero (~80vh, next section peeks below) ---------- */
  .hero {
    min-height: calc(80vh - var(--header-h));
    min-height: calc(80svh - var(--header-h));
    display: flex;
    align-items: center;
    padding-block: var(--space-7) var(--space-6);
  }

  .prompt {
    color: var(--accent);
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
  }

  .hero h1 {
    font-size: var(--text-hero);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin-bottom: var(--space-4);
  }

  .role {
    color: var(--ink-soft);
    font-size: var(--text-md);
    margin-bottom: var(--space-7);
  }

  .quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.25rem, 1rem + 1vw, 1.625rem);
    line-height: 1.5;
    max-width: 34ch;
    margin-bottom: var(--space-4);
  }

  .quote.upright {
    font-style: normal;
  }

  .quote-note {
    color: var(--ink-faint);
    font-size: var(--text-sm);
  }

  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.15em;
    vertical-align: text-bottom;
    background: var(--ink-faint);
    animation: blink 1.2s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .scroll-hint {
    display: inline-block;
    margin-top: var(--space-6);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    text-decoration: none;
    letter-spacing: 0.04em;
  }

  .scroll-hint:hover {
    color: var(--accent);
  }

  /* ---------- projects (editorial list, not cards) ---------- */
  .project-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    row-gap: var(--space-7);
    column-gap: var(--space-6);
  }

  @media (min-width: 48rem) {
    .project-grid {
      grid-template-columns: repeat(3, 1fr);
      row-gap: var(--space-8);
    }
  }

  .project {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    border-top: 1px solid var(--line-strong);
    padding-top: var(--space-4);
    transition: border-color 160ms var(--ease);
  }

  .project:hover {
    border-top-color: var(--accent);
  }

  .project h3 {
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .project h3 a {
    text-decoration: none;
  }

  .project h3 a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  /* small off-site indicator next to linked project names */
  .project h3 .ext {
    font-size: var(--text-md);
    font-weight: 400;
    color: var(--ink-faint);
    margin-left: var(--space-1);
    vertical-align: 0.4em;
  }

  .desc {
    flex: 1;
    color: var(--ink);
    font-size: var(--text-base);
    line-height: 1.6;
  }

  .meta {
    color: var(--ink-faint);
    font-size: var(--text-xs);
    letter-spacing: 0.01em;
  }

  /* ---------- photography (irregular contact sheet) ---------- */
  .photo-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4) var(--space-3);
  }

  @media (min-width: 48rem) {
    .photo-grid {
      grid-template-columns: repeat(6, 1fr);
      gap: var(--space-5) var(--space-4);
    }

    .ph-a {
      grid-column: span 2;
    }

    .ph-b {
      grid-column: span 4;
    }

    .ph-c {
      grid-column: span 3;
    }

    .ph-d {
      grid-column: span 3;
    }
  }

  .ph {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .ph-frame {
    background: var(--surface-dim);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    transition: border-color 160ms var(--ease);
  }

  .ph:hover .ph-frame {
    border-color: var(--accent);
  }

  /* one aspect ratio per frame — sizes stay irregular when
     real photos replace the placeholders */
  .ph-a .ph-frame {
    aspect-ratio: 3 / 4;
  }

  .ph-b .ph-frame {
    aspect-ratio: 16 / 10;
  }

  .ph-c .ph-frame {
    aspect-ratio: 1 / 1;
  }

  .ph-d .ph-frame {
    aspect-ratio: 4 / 5;
  }

  .ph figcaption {
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  /* ---------- writing (plain post list) ---------- */
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 42rem;
  }

  .post {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-1);
    padding-block: var(--space-4);
  }

  .post + .post {
    border-top: var(--border);
    padding-block: var(--space-5);
  }

  @media (min-width: 40rem) {
    .post {
      grid-template-columns: 7rem 1fr;
      gap: var(--space-4);
      padding-block: var(--space-5);
    }
  }

  .post time {
    color: var(--ink-faint);
    font-size: var(--text-sm);
    padding-top: 2px;
  }

  .post h3 {
    font-size: var(--text-md);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .post p {
    margin-top: var(--space-1);
    color: var(--ink-soft);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  /* ---------- about (prose + contact) ---------- */
  .about {
    max-width: 44rem;
  }

  .about-text p {
    max-width: 58ch;
    color: var(--ink-soft);
  }

  .about-text p + p {
    margin-top: var(--space-3);
  }

  .about-text p:first-child {
    color: var(--ink);
  }

  .contact {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: var(--space-4) 0 0;
    border-top: var(--border);
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .contact li {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--space-3);
  }

  .contact .k {
    color: var(--ink-faint);
  }

  .contact a {
    color: var(--ink);
    text-decoration: none;
  }

  .contact a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .contact .pending {
    color: var(--ink-faint);
    font-style: italic;
  }

  .contact .pending.upright {
    font-style: normal;
  }

  /* ---------- small screens ---------- */
  @media (max-width: 30rem) {
    /* keep the role line on one line */
    .role {
      font-size: var(--text-base);
    }

    .scroll-hint {
      margin-top: var(--space-5);
    }
  }
</style>
