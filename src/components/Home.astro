---
import type { Locale } from '../i18n/config';
import Hero from './Hero.astro';
import NowSection from './NowSection.astro';
import ProjectsSection from './ProjectsSection.astro';
import PhotographySection from './PhotographySection.astro';
import WritingSection from './WritingSection.astro';
import AboutSection from './AboutSection.astro';

/**
 * Homepage — composition only. Each section owns its own markup
 * and styles; the content itself lives in src/data/, the UI copy
 * in src/i18n/.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Hero locale={locale} />
<NowSection locale={locale} />
<ProjectsSection locale={locale} />
<PhotographySection locale={locale} />
<WritingSection locale={locale} />
<AboutSection locale={locale} />
